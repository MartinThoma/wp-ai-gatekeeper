<?xml version="1.0"?>
<ruleset name="WP AI Gatekeeper">
	<description>WordPress Coding Standards + PHP 7.4 compatibility for WP AI Gatekeeper.</description>

	<file>.</file>
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="parallel" value="8"/>
	<arg value="sp"/>

	<!-- Keep in sync with "Requires at least" / "Requires PHP" in wp-ai-gatekeeper.php. -->
	<config name="minimum_wp_version" value="6.0"/>
	<config name="testVersion" value="7.4-"/>

	<rule ref="WordPress">
		<!-- Class files are named class-<topic>.php (e.g. class-auth.php); renaming adds churn, no value. -->
		<exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
	</rule>

	<!-- The plugin owns custom tables; direct queries and schema changes are the point there. -->
	<rule ref="WordPress.DB.DirectDatabaseQuery">
		<exclude-pattern>/includes/class-database\.php$</exclude-pattern>
		<exclude-pattern>/uninstall\.php$</exclude-pattern>
	</rule>
	<rule ref="PHPCompatibilityWP"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="wp-ai-gatekeeper"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="wp_ai_gatekeeper"/>
				<element value="wpai"/>
			</property>
		</properties>
		<!-- Test bootstrap follows the WP core test-suite conventions. -->
		<exclude-pattern>/tests/*</exclude-pattern>
		<!-- Command-line tools: never loaded by WordPress and not shipped in the plugin zip. -->
		<exclude-pattern>/bin/*</exclude-pattern>
	</rule>

	<rule ref="WordPress.WP.GlobalVariablesOverride">
		<exclude-pattern>/bin/*</exclude-pattern>
	</rule>
</ruleset>
